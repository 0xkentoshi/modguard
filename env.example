TELEGRAM_BOT_TOKEN=
ADMIN_IDS=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3:1.7b
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=90
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=24h
WARMUP_MODELS_ON_START=true

FAST_NUM_CTX=2048
FAST_NUM_PREDICT=120
DEEP_NUM_CTX=4096
DEEP_NUM_PREDICT=320

DATABASE_URL=sqlite+aiosqlite:///modguard.db

CHAT_HISTORY_LIMIT=20
USER_HISTORY_LIMIT=10
MODERATION_HISTORY_LIMIT=10
DECISION_CACHE_TTL_SECONDS=45

DRY_RUN=true

LIVE_DELETE_ENABLED=false
LIVE_DELETE_CATEGORIES=spam,scam,phishing,malicious_link,unsolicited_advertising,flood
LIVE_DELETE_CHAT_IDS=

ADMIN_ALERT_COOLDOWN_SECONDS=60
NOTIFY_AUTONOMOUS_ACTIONS=false
NOTIFY_NEW_TICKETS=true

AUTONOMOUS_BAN_THRESHOLD=0.92
AUTONOMOUS_MUTE_THRESHOLD=0.85
AUTONOMOUS_DELETE_THRESHOLD=0.78
AUTONOMOUS_WARN_THRESHOLD=0.70

# Pilot safety circuit (automatic per-chat fail-closed SHADOW)
SAFETY_CIRCUIT_ENABLED=true
SAFETY_ACTION_WINDOW_SECONDS=60
SAFETY_MAX_DESTRUCTIVE_ACTIONS=20
SAFETY_MAX_PUNITIVE_ACTIONS=5
SAFETY_FAILURE_WINDOW_SECONDS=120
SAFETY_MAX_EXECUTION_FAILURES=3
SAFETY_MAX_PIPELINE_FAILURES=3
